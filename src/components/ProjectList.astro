---
import { projects } from '../data/projects';
---
<div class="project-list">{projects.map((project, index) => <article><span class="project-number">{String(index + 1).padStart(2, '0')}</span><div><h3><a href={project.url} target="_blank" rel="noopener noreferrer">{project.title} <span aria-hidden="true">↗</span></a></h3><p>{project.description}</p><ul class="inline-tags" aria-label="技术栈">{project.tags.map(tag => <li>{tag}</li>)}</ul></div><span class="project-kind">开源项目</span></article>)}</div>
