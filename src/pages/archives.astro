---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import { getPosts, postUrl, formatDate } from '../lib/posts';
const posts = await getPosts();
const years = [...new Set(posts.map(p => new Intl.DateTimeFormat('en', { year: 'numeric', timeZone: 'Asia/Shanghai' }).format(p.data.pubDate)))];
---
<Base title="归档"><PageHeading eyebrow="THE ARCHIVE / 时间的目录" title="归档" description={`共 ${posts.length} 篇记录，沿着时间慢慢翻阅。`} /><div class="archive-list">{years.map(year => <section><h2>{year}</h2><ul>{posts.filter(p => new Intl.DateTimeFormat('en', { year: 'numeric', timeZone: 'Asia/Shanghai' }).format(p.data.pubDate) === year).map(post => <li><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><a href={postUrl(post)}>{post.data.title}<span aria-hidden="true">↗</span></a></li>)}</ul></section>)}</div></Base>
