---
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
const categories = [...new Set(posts.flatMap(p => p.data.category ? [p.data.category] : []))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
---
<Base title="分类"><PageHeading eyebrow="THE SECTIONS / 分门别类" title="分类" description="从技术到生活，找到你想读的那一页。" /><ul class="taxonomy-list">{categories.map(category => <li><a href={`/categories/${encodeURIComponent(category)}/`}><span>{category}</span><span>{posts.filter(p => p.data.category === category).length} 篇 <span aria-hidden="true">↗</span></span></a></li>)}</ul><a class="back-link" href="/blog/">← 全部文章</a></Base>
