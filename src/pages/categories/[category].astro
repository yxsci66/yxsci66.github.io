---
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.flatMap(p => p.data.category ? [p.data.category] : []))].map(category => ({ params: { category }, props: { category, posts: posts.filter(p => p.data.category === category) } }));
}
const { category, posts } = Astro.props;
---
<Base title={`分类：${category}`}><PageHeading eyebrow="THE SECTIONS / 分类" title={category} description={`${posts.length} 篇记录`} /><PostList posts={posts} /><a class="back-link" href="/categories/">← 全部分类</a></Base>
