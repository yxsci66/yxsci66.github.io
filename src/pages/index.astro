---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { getPosts } from '../lib/posts';
const posts = await getPosts();
const selected = [...posts.filter(p => p.data.featured), ...posts.filter(p => !p.data.featured)].slice(0, 3);
---
<Base>
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow">一个人的数字花园 / A PERSONAL JOURNAL</p><h1 aria-label="Harlen's World">Harlen's<br /><em>World</em><span class="brand-dot" aria-hidden="true">.</span></h1><p class="hero-subtitle">重度文青，搬砖码农</p><p class="hero-description">在文字里整理思绪，在代码里探索可能。<br />这里收录技术的琐碎，也留住生活的片刻。</p><a class="text-link" href="/blog/">翻开文章 <span aria-hidden="true">↗</span></a></div>
    <figure class="hero-image"><img src="/images/avatar.jpg" alt="Harlen 的个人头像" width="480" height="400" fetchpriority="high" /><figcaption><span>01 / 关于日常与想象</span><span>HARLEN'S WORLD</span></figcaption></figure>
  </section>
  <section class="home-section"><header class="section-heading"><div><p class="eyebrow">01 / WORDS & NOTES</p><h2>最近的文字</h2></div><a class="text-link" href="/blog/">全部文章 <span aria-hidden="true">→</span></a></header><PostList posts={selected} /></section>
  <section class="home-section"><header class="section-heading"><div><p class="eyebrow">02 / BUILD & EXPLORE</p><h2>动手做的事</h2></div><a class="text-link" href="/projects/">查看项目 <span aria-hidden="true">→</span></a></header><ProjectList /></section>
  <aside class="home-note"><span class="eyebrow">KEEP IN TOUCH</span><p>如果你也喜欢文字与代码，<br />欢迎在 <a href="https://github.com/yxsci66" target="_blank" rel="noopener noreferrer">GitHub ↗</a> 遇见。</p></aside>
</Base>
